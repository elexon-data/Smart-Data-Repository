root = true

# Global Settings (all files)
[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
# tab_width = 4# DEFAULT: matches indent_size
insert_final_newline = true
trim_trailing_whitespace = true

# File-Type Specific Settings
[*.{yml,yaml}]
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.{json,bicep}]
indent_size = 2

# C# Code Style
[*.cs]

# Namespace Declarations
csharp_style_namespace_declarations = file_scoped:warning

# this. Qualifier (SA1101 enforced as error)
dotnet_style_qualification_for_field = true:warning
dotnet_style_qualification_for_property = true:warning
dotnet_style_qualification_for_method = true:warning
dotnet_style_qualification_for_event = true:warning
dotnet_diagnostic.SA1101.severity = error
dotnet_diagnostic.SX1101.severity = none

# Expression-Bodied Members
csharp_style_expression_bodied_constructors = when_on_single_line:warning
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion

# Field & Parameter Preferences
dotnet_style_readonly_field = true:warning

# Unused Values
csharp_style_unused_value_assignment_preference = discard_variable:error

# Braces & Using Statements
csharp_prefer_simple_using_statement = true:suggestion

# New Line Preferences (dotnet) - Non-defaults
dotnet_style_allow_multiple_blank_lines_experimental = false:suggestion
dotnet_style_allow_statement_immediately_after_block_experimental = false:suggestion

# New Line Preferences (csharp)
csharp_style_allow_blank_line_after_colon_in_constructor_initializer_experimental = false:suggestion
csharp_style_allow_blank_line_after_token_in_conditional_expression_experimental = false:suggestion
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = false:suggestion

# Diagnostic Severities - StyleCop (all are non-default overrides)
dotnet_diagnostic.SA1000.severity = silent
dotnet_diagnostic.SA1009.severity = silent
dotnet_diagnostic.SA1010.severity = none
dotnet_diagnostic.SA1111.severity = silent
dotnet_diagnostic.SA1122.severity = none
dotnet_diagnostic.SA1127.severity = silent
dotnet_diagnostic.SA1200.severity = silent
dotnet_diagnostic.SA1208.severity = silent
dotnet_diagnostic.SA1310.severity = suggestion
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1413.severity = silent
dotnet_diagnostic.SA1600.severity = warning
dotnet_diagnostic.SA1633.severity = silent

# Diagnostic Severities - Code Analysis (CA) - Non-default overrides
dotnet_diagnostic.CA1716.severity = silent
dotnet_diagnostic.CA1720.severity = silent
dotnet_diagnostic.CA1822.severity = silent
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA2254.severity = none

# Diagnostic Severities - SonarAnalyzer (explicit -- mirrors "Elexon way" SonarCloud quality profile)
dotnet_diagnostic.S1006.severity             = warning  # Method overrides should not change parameter defaults (SonarCloud: CRITICAL)
dotnet_diagnostic.S101.severity              = warning  # Types should be named in PascalCase (SonarCloud: MINOR)
dotnet_diagnostic.S1048.severity             = error  # Finalizers should not throw exceptions (SonarCloud: BLOCKER)
dotnet_diagnostic.S106.severity              = warning  # Standard outputs should not be used directly to log anything (SonarCloud: MAJOR)
dotnet_diagnostic.S1066.severity             = warning  # Mergeable "if" statements should be combined (SonarCloud: MAJOR)
dotnet_diagnostic.S1067.severity             = warning  # Expressions should not be too complex (SonarCloud: CRITICAL)
dotnet_diagnostic.S107.severity              = warning  # Methods should not have too many parameters (SonarCloud: MAJOR)
dotnet_diagnostic.S1075.severity             = warning  # URIs should not be hardcoded (SonarCloud: MINOR)
dotnet_diagnostic.S108.severity              = warning  # Nested blocks of code should not be left empty (SonarCloud: MAJOR)
dotnet_diagnostic.S109.severity              = warning  # Magic numbers should not be used (SonarCloud: MAJOR)
dotnet_diagnostic.S110.severity              = warning  # Inheritance tree of classes should not be too deep (SonarCloud: MAJOR)
dotnet_diagnostic.S1104.severity             = warning  # Fields should not have public accessibility (SonarCloud: MINOR)
dotnet_diagnostic.S1110.severity             = warning  # Redundant pairs of parentheses should be removed (SonarCloud: MAJOR)
