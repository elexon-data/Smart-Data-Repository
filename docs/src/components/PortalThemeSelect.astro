---
import StarlightThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
---

<StarlightThemeSelect />
<label class="portal-theme-select">
  <span>Portal theme</span>
  <select data-portal-theme-select aria-label="Portal theme">
    <option value="starlight">Starlight</option>
    <option value="sdr">SDR portal</option>
  </select>
</label>

<script>
  const themeSelects = document.querySelectorAll<HTMLSelectElement>(
    '[data-portal-theme-select]',
  );
  const storageKey = 'sdr-developer-portal-theme';

  function applyTheme(theme: string) {
    const isSdrTheme = theme === 'sdr';
    if (isSdrTheme) {
      document.documentElement.dataset.portalTheme = 'sdr';
    } else {
      delete document.documentElement.dataset.portalTheme;
    }
    themeSelects.forEach((select) => {
      select.value = isSdrTheme ? 'sdr' : 'starlight';
    });
  }

  try {
    applyTheme(localStorage.getItem(storageKey) ?? 'starlight');
  } catch {
    applyTheme('starlight');
  }

  themeSelects.forEach((select) => {
    select.addEventListener('change', () => {
      applyTheme(select.value);
      try {
        localStorage.setItem(storageKey, select.value);
      } catch {
        // The selected theme remains active for this page when storage is unavailable.
      }
    });
  });
</script>

<style>
  .portal-theme-select {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .portal-theme-select select {
    border: 1px solid currentColor;
    border-radius: 0.25rem;
    padding: 0.3rem 0.45rem;
    background: var(--sl-color-bg-nav);
    color: inherit;
    font: inherit;
  }

  .portal-theme-select select:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  @media (max-width: 49.999rem) {
    .portal-theme-select {
      justify-content: space-between;
    }
  }
</style>
