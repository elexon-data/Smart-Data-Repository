# Only exclude local development overrides (.env, .env.local, .env.*.local).
.env
.env.local
.env.*.local
config/.env.local
config/.env.*.local
web/.env
web/.env.local
web/.env.*.local
*.pem
*.key
*.p12
*.pfx
secrets.json
*.publishsettings

